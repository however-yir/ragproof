<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ run.name }} — RAG Evaluation Report</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: -apple-system, "Segoe UI", sans-serif; max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
  h1 { border-bottom: 2px solid #4f8ef7; padding-bottom: .4rem; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; font-size: .9rem; }
  th, td { border: 1px solid #8884; padding: .45rem .6rem; text-align: left; }
  th { background: #4f8ef71a; }
  .metric-cards { display: flex; flex-wrap: wrap; gap: .8rem; margin: 1rem 0; }
  .card { border: 1px solid #8884; border-radius: 8px; padding: .8rem 1.1rem; min-width: 130px; }
  .card .value { font-size: 1.5rem; font-weight: 700; color: #4f8ef7; }
  .card .label { font-size: .75rem; opacity: .75; }
  .err { color: #d33; }
  footer { margin-top: 2rem; font-size: .8rem; opacity: .6; }
</style>
</head>
<body>
<h1>{{ run.name }}</h1>
<p><b>Timestamp:</b> {{ run.timestamp }} · <b>Dataset:</b> <code>{{ run.dataset }}</code> · <b>Samples:</b> {{ run.sample_count }}</p>

<h2>Aggregate Metrics</h2>
<div class="metric-cards">
{% for name, value in run.aggregate.items() %}
  <div class="card"><div class="value">{{ "%.3f"|format(value) }}</div><div class="label">{{ name }}</div></div>
{% endfor %}
</div>

<h2>Per-Sample Results</h2>
<table>
<tr><th>ID</th><th>Question</th><th>Answer</th><th>Metrics</th><th>Latency (ms)</th><th>Error</th></tr>
{% for r in run.results %}
<tr>
  <td>{{ r.id }}</td>
  <td>{{ r.question[:80] }}</td>
  <td>{{ r.answer[:120] }}</td>
  <td>{% for k, v in r.metrics.items() %}{% if v is not none %}<code>{{ k }}={{ "%.2f"|format(v) }}</code> {% endif %}{% endfor %}</td>
  <td>{{ "%.0f"|format(r.latency_ms) }}</td>
  <td class="err">{{ r.error or "" }}</td>
</tr>
{% endfor %}
</table>

<footer>Generated by <a href="https://github.com/however-yir/ragproof">ragproof</a></footer>
</body>
</html>
