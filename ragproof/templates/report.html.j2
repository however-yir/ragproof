<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ run.name }} · ragproof</title>
  <style>
    :root { color-scheme: light dark; --bg:#10151c; --card:#18222d; --muted:#9fb0c0; --text:#edf4fa; --good:#38d39f; --bad:#ff6b7a; }
    body { font: 14px/1.5 system-ui,sans-serif; max-width: 1280px; margin: 32px auto; padding: 0 20px; background:var(--bg); color:var(--text); }
    h1 { margin-bottom: 4px; } .meta { color:var(--muted); font-size:12px; }
    .cards { display:flex; flex-wrap:wrap; gap:10px; margin:20px 0; }
    .card { background:var(--card); border:1px solid #2a3948; border-radius:10px; padding:12px 16px; min-width:145px; }
    .metric { color:var(--muted); font-size:12px; } .value { font-size:22px; font-weight:700; }
    .good { color:var(--good); } .bad { color:var(--bad); }
    input, select, button { background:var(--card); color:var(--text); border:1px solid #405365; border-radius:6px; padding:7px; }
    .toolbar { display:flex; flex-wrap:wrap; gap:8px; margin:16px 0; }
    table { width:100%; border-collapse:collapse; background:var(--card); }
    th,td { padding:9px; border-bottom:1px solid #2a3948; text-align:left; vertical-align:top; }
    th { cursor:pointer; color:var(--muted); position:sticky; top:0; background:var(--card); }
    .question { max-width:300px; } .answer { max-width:380px; white-space:pre-wrap; }
    details { color:var(--muted); } code { color:#b8d9ff; } .hidden { display:none; }
  </style>
</head>
<body>
  <h1>{{ run.name }}</h1>
  <div class="meta">ragproof {{ run.ragproof_version | default('unknown') }} · {{ run.timestamp }} · {{ run.sample_count }} selected / {{ run.dataset_sample_count | default(run.sample_count) }} samples · {{ '%.0f'|format(run.duration_ms|default(0)) }} ms</div>
  {% if run.git_sha %}<div class="meta">git: <code>{{ run.git_sha }}</code></div>{% endif %}

  {% if run.coverage %}
  <details><summary>Data coverage</summary>
    <table><thead><tr><th>Field / metric</th><th>Available</th><th>Total</th><th>Rate</th></tr></thead><tbody>
    {% for name, item in run.coverage.fields.items() %}<tr><td><code>{{ name }}</code></td><td>{{ item.available }}</td><td>{{ item.total }}</td><td>{{ '%.1f'|format(item.rate * 100) }}%</td></tr>{% endfor %}
    {% for name, item in run.coverage.metrics.items() %}<tr><td><code>{{ name }}</code></td><td>{{ item.available }}</td><td>{{ item.total }}</td><td>{{ '%.1f'|format(item.rate * 100) }}%</td></tr>{% endfor %}
    </tbody></table>
  </details>
  {% endif %}

  <section class="cards">
    {% for name, value in run.aggregate.items() %}
    <div class="card"><div class="metric">{{ name }}</div><div class="value">{{ '%.3f'|format(value) if value is number else value }}</div></div>
    {% endfor %}
  </section>

  {% if run.comparison %}
  <h2>Baseline comparison <span class="{{ 'good' if run.comparison.passed else 'bad' }}">{{ 'PASS' if run.comparison.passed else 'FAIL' }}</span></h2>
  <ul>{% for item in run.comparison.results %}<li class="{{ 'good' if item.passed else 'bad' }}">{{ item.metric }}: {{ item.reason }}</li>{% endfor %}</ul>
  {% endif %}

  <div class="toolbar">
    <input id="filter" placeholder="Filter question, id, tag, error…">
    <select id="status"><option value="all">All samples</option><option value="failed">Failures only</option><option value="passed">No errors</option></select>
    <button id="copy-failures">Copy failed JSON</button>
    <button id="reset">Reset</button>
  </div>
  <table id="samples"><thead><tr>
    <th data-sort="id">ID</th><th data-sort="question">Question</th><th>Answer</th><th>Tags</th><th>Retrieval / citations</th><th data-sort="latency_ms">Latency</th><th>Status</th>
  </tr></thead><tbody>
  {% for result in run.results %}
    <tr data-id="{{ result.id }}" data-search="{{ (result.id ~ ' ' ~ result.question ~ ' ' ~ (result.tags|join(' ')) ~ ' ' ~ (result.error|default(''))) | lower }}" data-status="{{ 'failed' if result.error else 'passed' }}" data-latency="{{ result.latency_ms }}">
      <td><code>{{ result.id }}</code></td>
      <td class="question">{{ result.question }}</td>
      <td class="answer">{{ result.answer }}{% if result.contexts %}<details><summary>Contexts ({{ result.contexts|length }})</summary>{% for context in result.contexts %}<p>{{ context[:300] }}{% if context|length > 300 %}…{% endif %}</p>{% endfor %}</details>{% endif %}</td>
      <td>{{ result.tags|join(', ') }}<br><small>{{ result.difficulty }}</small></td>
      <td><div>docs: <code>{{ result.context_ids|join(', ') }}</code></div><div>citations: <code>{{ result.citations|join(', ') }}</code></div>{% for name,value in result.metrics.items() %}<div class="metric">{{ name }}: {{ '%.3f'|format(value) if value is not none else 'N/A' }}</div>{% endfor %}</td>
      <td>{{ '%.1f'|format(result.latency_ms) }} ms</td>
      <td class="{{ 'bad' if result.error else 'good' }}">{{ result.error_type or ('error: ' ~ result.error if result.error else 'ok') }}</td>
    </tr>
  {% endfor %}
  </tbody></table>
  <script>
    const rows = [...document.querySelectorAll('#samples tbody tr')];
    const filter = document.querySelector('#filter'), status = document.querySelector('#status');
    function apply() { const q=(filter.value||'').toLowerCase(), s=status.value; rows.forEach(r => r.classList.toggle('hidden', (q && !r.dataset.search.includes(q)) || (s !== 'all' && r.dataset.status !== s))); }
    filter.addEventListener('input', apply); status.addEventListener('change', apply);
    document.querySelector('#reset').addEventListener('click', () => { filter.value=''; status.value='all'; apply(); });
    document.querySelectorAll('th[data-sort]').forEach(th => th.addEventListener('click', () => { const key=th.dataset.sort; rows.sort((a,b) => (key==='latency_ms' ? Number(a.dataset.latency)-Number(b.dataset.latency) : a.dataset.search.localeCompare(b.dataset.search))); const body=document.querySelector('#samples tbody'); rows.forEach(r=>body.appendChild(r)); }));
    document.querySelector('#copy-failures').addEventListener('click', async () => { const data={{ run.results|tojson }}; await navigator.clipboard.writeText(JSON.stringify(data.filter(x=>x.error), null, 2)); });
  </script>
</body>
</html>
